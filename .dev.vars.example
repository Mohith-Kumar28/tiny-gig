BETTER_AUTH_SECRET=replace-with-32+-random-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty in dev to log emails (and OTP codes) to the console instead of sending.
RESEND_API_KEY=

# Local override of the production APP_URL in wrangler.jsonc
APP_URL=http://localhost:3000

# Web push keys (VAPID). Generate a P-256 pair; public = raw point base64url, private = JWK "d".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
