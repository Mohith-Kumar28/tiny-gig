/**
 * TinyGig — Cloudflare Worker config.
 * Replace the placeholder IDs after running:
 *   wrangler d1 create tinygig-db
 *   wrangler kv namespace create CACHE
 *   wrangler r2 bucket create tinygig-uploads
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tinygig",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		"APP_URL": "https://tinygig.mohithkumar808.workers.dev",
		"APP_NAME": "TinyGig",
		"EMAIL_FROM": "TinyGig <mail@monway.ai>",
		"ADMIN_EMAILS": "mohith@tokgency.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tinygig-db",
			"database_id": "20ba147e-3cf0-4df0-bc84-efb200ca5443",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [{ "binding": "CACHE", "id": "d58126541e1c4277988dcbabe1e8d359" }],
	"r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "tinygig-uploads" }],
	"triggers": { "crons": ["*/15 * * * *"] }
}
