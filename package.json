{
  "name": "tinygig",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tinygig-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tinygig-db --remote",
    "secrets:push": "bun scripts/secrets-push.ts",
    "vapid:new": "bun scripts/generate-vapid.ts",
    "db:seed:local": "wrangler d1 execute tinygig-db --local --file=./scripts/seed.sql",
    "og": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --hide-scrollbars --allow-file-access-from-files --force-device-scale-factor=1 --window-size=1200,630 --virtual-time-budget=3000 --screenshot=public/og.png \"file://$PWD/scripts/og/og.html\""
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@daveyplate/better-auth-ui": "3.4.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context": "^1.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-primitive": "^2.2.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-use-callback-ref": "^1.1.5",
    "@radix-ui/react-use-layout-effect": "^1.1.4",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.58.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "recharts": "3.8.0",
    "resend": "^6.34.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
