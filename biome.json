{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "tests/**", "scripts/**", "*.ts", "!src/routeTree.gen.ts", "!src/components/ui/**", "!worker-configuration.d.ts"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 130 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "noSvgWithoutTitle": "off" },
      "suspicious": { "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
